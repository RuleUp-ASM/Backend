DB_USERNAME=ruleup
DB_PASSWORD=ruleup_local_pw

JWT_SECRET=replace_me

KAKAO_REST_API_KEY=replace_me
KAKAO_CLIENT_SECRET=replace_me
KAKAO_REDIRECT_URI=ruleup://auth/callback

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=ruleup://auth/callback

# 서버 콜백이 인가코드를 앱으로 넘길 커스텀 스킴 딥링크 (iOS 카카오 로그인용, 없으면 ruleup://login/callback)
APP_OAUTH_REDIRECT_URI=ruleup://login/callback

GEMINI_API_KEY=

# 감시자 비유저 연락처 암호화 키(AES-256, base64 32바이트). prod 필수(Secrets Manager).
# 로컬/테스트는 미설정 시 프로세스 임시 키로 동작(재기동 시 기존 데이터 복호화 불가).
WATCHER_CONTACT_SECRET=
# 감시자 초대 링크 베이스 URL(카톡 공유용). 기본값 https://ruleup.app
WATCHER_INVITE_BASE_URL=

# 탐색 파생 인덱스 저장소(Redis). 로컬은 docker-compose 의 redis 서비스가 이 기본값으로 뜬다.
# stg/prod 는 ECS 태스크 정의가 SPRING_DATA_REDIS_HOST 로 ElastiCache 엔드포인트를 주입한다.
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 를 안 띄우고 돌릴 때는 false — 회로차단기를 기다리지 않고 처음부터 MySQL 경로로 간다.
EXPLORE_REDIS_ENABLED=true
