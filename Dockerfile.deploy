# 빌드 스테이지: 러너 네이티브(x86)에서 — gradle 빌드를 에뮬레이션 없이 빠르게.
# jar는 플랫폼 무관이라 arm64 런타임에 그대로 COPY 가능.
FROM --platform=$BUILDPLATFORM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY . .
RUN chmod +x gradlew && ./gradlew clean bootJar -x test --no-daemon

# 런타임 스테이지: target(arm64) — ECS Fargate ARM64.
# 버전을 고정한다 — 떠다니는 25-jre 태그는 배포 때마다 JRE 가 말없이 바뀐다.
FROM eclipse-temurin:25.0.5_8-jre
# eMudhra 중간 CA 키 유출(CVE-2026-91403·CVE-2026-114820): 25.0.5+8 에도 emSign Root CA - G1 이 남아 있어
# 이 회사 루트를 cacerts 에서 모두 지운다. 서버가 부르는 곳(Google·카카오·네이버·Apple·AWS·Slack)은 이 루트를 쓰지 않는다(2026-10-30 확인).
# OpenJDK 원본 수정(JDK-8395690)이 들어간 Temurin 으로 올리면 이 단계는 지워도 된다.
RUN set -eu; \
    keytool -list -cacerts -storepass changeit | grep -iE 'emsign|emudhra' | sed 's/, .*//' | while IFS= read -r alias; do \
      keytool -delete -cacerts -storepass changeit -alias "$alias"; \
    done; \
    ! keytool -list -cacerts -storepass changeit | grep -iqE 'emsign|emudhra'
WORKDIR /app
# 트레이스(X-Ray) 용 ADOT Java 에이전트. 이미지에는 늘 들어 있고, 태스크 정의 env OTEL_ENABLED=true 일 때만 붙는다.
# 구성: infra/monitoring/tracing/README.md
ARG ADOT_JAVA_AGENT_VERSION=v2.31.0
ADD https://github.com/aws-observability/aws-otel-java-instrumentation/releases/download/${ADOT_JAVA_AGENT_VERSION}/aws-opentelemetry-agent.jar /app/otel/aws-opentelemetry-agent.jar
COPY --from=build /src/build/libs/*.jar app.jar
COPY infra/monitoring/tracing/entrypoint.sh /app/entrypoint.sh
# glibc 는 스레드마다 64MB 단위 malloc 아레나를 늘려 가며 돌려주지 않는다. stg(1GB 태스크)에서 JVM RSS 800MB 중
# 힙은 256MB 였고 아레나가 ~200MB 를 차지해, 하루쯤마다 하드 메모리 80% 경보(ECS-06-80)를 다시 울렸다(2026-10-14 smaps 실측).
# 아레나 수를 묶으면 네이티브 할당이 몇 개 아레나를 같이 쓰게 되어 RSS 가 천천히 차오르지 않는다.
ENV MALLOC_ARENA_MAX=2
EXPOSE 8080
ENTRYPOINT ["sh","/app/entrypoint.sh"]
